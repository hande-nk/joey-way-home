# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Secret Joey's phone uses to post his location. Pick any long random string.
RIDER_KEY=
# Secret for the /control page. Pick a different long random string.
HOST_KEY=

# Added automatically when you connect Upstash Redis from the Vercel Storage tab.
# Leave empty locally and the app keeps state in memory instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
